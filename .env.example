# Host ports (non-default to avoid clashes with other local projects)
API_PORT=58081
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_API_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
REVERSE_PROXY_HOST_PORT=58080

# PostgreSQL
POSTGRES_DB=school_camera
POSTGRES_USER=school_camera_user
POSTGRES_PASSWORD=school_camera_pass
DATABASE_URL=postgres://school_camera_user:school_camera_pass@postgres:5432/school_camera?sslmode=disable

# JWT / auth
JWT_ACCESS_SECRET=local_dev_access_secret_change_me
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12

# AES-256-GCM for RTSP URLs at rest (32-byte key, base64). Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=JQxSM+BF3X56J3bsBKijVw0nnmXkCY8itW3xTqNIHeM=

# Redis (in-cluster address for Go services)
REDIS_ADDR=redis:6379

# Object storage (MinIO locally, Cloudflare R2 in production)
STORAGE_PROVIDER=minio
# allowed: minio, r2

# MinIO / S3-compatible
MINIO_ROOT_USER=minioadmin_local
MINIO_ROOT_PASSWORD=minioadmin_local_pass
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_BUCKET=school-camera-local
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin_local
S3_SECRET_KEY=minioadmin_local_pass
S3_FORCE_PATH_STYLE=true

# Production R2 example (do not commit real credentials):
# STORAGE_PROVIDER=r2
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<PUBLIC_R2_OR_CUSTOM_DOMAIN>
# S3_BUCKET=<R2_BUCKET_NAME>
# S3_REGION=auto
# S3_ACCESS_KEY=<R2_ACCESS_KEY>
# S3_SECRET_KEY=<R2_SECRET_KEY>
# S3_FORCE_PATH_STYLE=true

# Signed URL lifetime returned by GET /demo/live
SIGNED_URL_EXPIRY=1h

# HLS stream worker
# Stream worker mode:
#   demo  = sample video only (local dev)
#   rtsp  = real RTSP cameras only (production after demo retired)
#   mixed = demo cameras + real RTSP (recommended for first real camera pilot)
STREAM_WORKER_MODE=demo
# Tailscale/WireGuard RTSP URLs are stored via admin API (encrypted), not in .env.
STREAM_WORKER_POLL_SECONDS=15
STREAM_WORKER_NAME=stream-worker-1
STREAM_WORKER_MAX_RESTARTS=10
STREAM_UPLOAD_MAX_RETRIES=5
STREAM_UPLOAD_RETRY_BASE_SECONDS=2
CAMERA_OFFLINE_AFTER_SECONDS=120
STREAM_TEMP_CLEANUP_INTERVAL_SECONDS=300
STREAM_TEMP_MAX_AGE_MINUTES=30
HLS_DEMO_CAMERA_ID=demo
HLS_SEGMENT_SECONDS=10
HLS_LOCAL_TMP_DIR=/tmp/hls
LIVE_DELAY_SECONDS=30

# Deployment / security
APP_ENV=local
DOMAIN=localhost
CADDY_EMAIL=
# Comma-separated browser origins allowed to call the API (admin dashboard, etc.)
# Required in production when the frontend is on a different origin than the API.
# CORS_ALLOWED_ORIGINS=http://localhost:53000,http://127.0.0.1:53000
DEMO_LIVE_ENABLED=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IP_WINDOW_SECONDS=60
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_EMAIL_WINDOW_SECONDS=900
AUTH_REFRESH_IP_LIMIT=60
AUTH_REFRESH_IP_WINDOW_SECONDS=60
AUTH_REFRESH_TOKEN_LIMIT=10
AUTH_REFRESH_TOKEN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_FAIL_CLOSED_PRODUCTION=true
S3_BUCKET_PUBLIC_ACCESS=false

# Admin monitoring
DASHBOARD_CACHE_TTL_SECONDS=45
WORKER_STALE_THRESHOLD_SECONDS=120

# Parent playback
LIVE_PLAYBACK_URL_TTL_MINUTES=3
RECORDING_PLAYBACK_URL_TTL_MINUTES=10
LIVE_DELAY_SECONDS=30
SCHOOL_TIMEZONE=Africa/Addis_Ababa
RECORDING_START_TIME=08:30
RECORDING_END_TIME=16:30
RECORDING_DAYS=MON,TUE,WED,THU,FRI
PLAYBACK_RATE_LIMIT_PER_MINUTE=60
TIMELINE_SEGMENT_GAP_SECONDS=30

# Health worker
HEALTH_WORKER_NAME=health-worker-1
HEALTH_CHECK_INTERVAL_SECONDS=30
CAMERA_OFFLINE_ALERT_SECONDS=300
SCHOOL_OFFLINE_ALERT_SECONDS=600
NO_SEGMENT_ALERT_SECONDS=180
PLAYLIST_STALE_ALERT_SECONDS=180
UPLOAD_FAILURE_ALERT_COUNT=5
FFMPEG_RESTART_ALERT_COUNT=5
HEALTH_EVENT_LOOKBACK_MINUTES=10
STREAM_WORKER_STALE_INTERVAL_MULTIPLIER=2

# Alert worker (Telegram delivery; disabled by default locally)
ALERT_WORKER_NAME=alert-worker-1
ALERT_WORKER_POLL_SECONDS=15
ALERT_DELIVERY_MAX_ATTEMPTS=5
ALERT_SEND_SEVERITIES=CRITICAL,WARNING
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler worker (controls camera_stream_states.desired_state for stream-worker)
SCHEDULER_WORKER_NAME=scheduler-worker-1
SCHEDULER_TIMEZONE=Africa/Addis_Ababa
SCHEDULER_RECORDING_START_TIME=08:30
SCHEDULER_RECORDING_END_TIME=16:30
SCHEDULER_RECORDING_DAYS=MON,TUE,WED,THU,FRI
SCHEDULER_POLL_SECONDS=30

# Retention worker (cloud recording cleanup; does not manage on-prem NVR)
RETENTION_WORKER_NAME=retention-worker-1
RETENTION_RUN_INTERVAL_MINUTES=60
RETENTION_BATCH_SIZE=1000
RETENTION_DRY_RUN=false
RETENTION_DELETE_OBJECTS=true
RETENTION_DELETE_DB_ROWS=true
RETENTION_RECORDING_DAYS=7
TEMP_PLAYBACK_RETENTION_MINUTES=10
STORAGE_USAGE_REPORT_HOUR=23
