# Example production Caddyfile for a custom domain (copy to server Caddy mount).
# Do NOT use respond "school-camera-api" as a catch-all — proxy to the API instead.

camera.example.com {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:58081
	}

	handle {
		reverse_proxy api:58081
	}
}
