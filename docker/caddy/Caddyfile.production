# Production — automatic HTTPS via Let's Encrypt. Set DOMAIN and CADDY_EMAIL in .env.
{
	admin off
	email {$CADDY_EMAIL}
}

{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# Optional /api prefix (e.g. GET /api/health → GET /health on the API).
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:{$API_PORT:58081}
	}

	# All other paths go to the Go API (/, /health, /auth, /parent, /admin, /db, /demo, …).
	handle {
		reverse_proxy api:{$API_PORT:58081}
	}
}
