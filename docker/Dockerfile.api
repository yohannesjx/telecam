# syntax=docker/dockerfile:1
# API image includes the migrate CLI and SQL migration/seed files.

ARG GO_VERSION=1.25
FROM golang:${GO_VERSION}-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/api ./apps/api
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/migrate ./apps/migrate

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /out/api /app/service
COPY --from=builder /out/migrate /app/migrate
COPY migrations /app/migrations

ENTRYPOINT ["/app/service"]
